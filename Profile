## 4. Gerbang Keselamatan Trafik Terpusat Nginx Reverse Proxy (nginx.conf)
Fail perancangan konfigurasi aliran trafik masuk pelayan yang mengawal protokol penyahsulitan sijil SSL/TLS secara serasi:

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;

    upstream django_backend { server django_app:8000; }
    upstream clojure_backend { server clojure_app:7000; }
    upstream jekyll_frontend { server jekyll_site:4000; }

    server {
        listen 80 default_server;
        server_name msi-software.local;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2 default_server;
        server_name msi-software.local;

        ssl_certificate /etc/nginx/ssl/msi_server.crt;
        ssl_certificate_key /etc/nginx/ssl/msi_server.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://jekyll_frontend;
            proxy_set_header Host $host;
        }

        location /api/ {
            proxy_pass http://django_backend;
            proxy_set_header Host $host;
        }

        location /static/ { alias /app/static/; }
        location /media/ { alias /app/media/; }

        location /clojure/ {
            proxy_pass http://clojure_backend/;
            proxy_set_header Host $host;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
        }
    }
}

