#!/bin/sh
# Menghentikan serta-merta jika terdapat sebarang kegagalan arahan (Strict Mode)set -e

echo "====================================================================="# CITATION REFERENCE: System Core Initialisation
echo "🚀 [SGAE CORE ENGINE] MEMULAKAN SISTEM AUTOMATIK PERSEKITARAN MASUK"
echo "====================================================================="
# 1. MEKANISME PENGAKAWALAN PANGKALAN DATA (DATABASE GATING)if [ "$DB_ENGINE" = "django.db.backends.postgresql" ]; then
    echo "🔍 [CHECK] Menilai status kesediaan pelayan pangkalan data di $DB_HOST:$DB_PORT..."
    
    # Pengulangan semakan port rangkaian sehingga bersedia sepenuhnya
    while ! nc -z "$DB_HOST" "$DB_PORT"; do
      echo "⏳ [WAIT] Pelayan PostgreSQL belum bersedia. Mencuba semula dalam 1 saat..."
      sleep 1
    done
    echo "✅ [SUCCESS] Sambungan rangkaian port $DB_PORT telah berjaya dihubungkan!"fi
# 2. AUTOMASI PENGURUSAN SKEMA (MIGRATIONS)
echo "📦 [MIGRATE] Menyemak dan menyelaraskan perubahan model kod ke pangkalan data..."
python manage.py makemigrations --noinput
python manage.py migrate --noinput
echo "✅ [SUCCESS] Skema pangkalan data PostgreSQL telah dikemas kini."
# 3. PENGURUSAN PENGUMPULAN ASET STATIK (STATIC STORAGE)
echo "🎨 [ASSETS] Mengumpul fail-fail statik (CSS/JS/Imej) ke STATIC_ROOT..."
python manage.py collectstatic --noinput --clear
echo "✅ [SUCCESS] Pengumpulan aset statik selesai untuk kegagalan cache Nginx."
# 4. PENGALIHAN PROSES UTAMA (HANDOFF EXECUTION)
echo "====================================================================="
echo "⚙️ [RUN] Menyerahkan proses utama kepada pelayan Gunicorn / Development..."
echo "====================================================================="
# Mengekalkan ID proses kontena utama tanpa meninggalkan proses bash di belakang
exec "$@"

