version: '3.8'
services:
  postgres_db:
    image: postgres:15-alpine
    container_name: msi-postgres-service
    environment:
      POSTGRES_DB: django_test_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres_password
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d django_test_db"]
      interval: 5s
      timeout: 5s
      retries: 5

  django_app:
    build:
      context: ./django-project
      dockerfile: Dockerfile
    container_name: msi-django-app
    command: python manage.py runserver 0.0.0.0:8000
    volumes:
      - ./django-project:/app
    ports:
      - "8000:8000"
    environment:
      - DB_ENGINE=django.db.backends.postgresql
      - DB_NAME=django_test_db
      - DB_USER=postgres
      - DB_PASSWORD=postgres_password
      - DB_HOST=postgres_db
      - DB_PORT=5432
    depends_on:
      postgres_db:
        condition: service_healthy

  clojure_app:
    image: clojure:lein-alpine
    container_name: msi-clojure-engine
    working_dir: /app
    volumes:
      - ./clojure-project:/app
      - lein_cache:/root/.m2
    command: lein repl :headless :host 0.0.0.0 :port 7000
    ports:
      - "7000:7000"

  jekyll_site:
    image: jekyll/jekyll:latest
    container_name: msi-jekyll-site
    working_dir: /srv/jekyll
    volumes:
      - ./jekyll-project:/srv/jekyll
    command: jekyll serve --host 0.0.0.0 --port 4000 --livereload --future
    ports:
      - "4000:4000"
      - "35729:35729"

  nginx_server:
    image: nginx:alpine
    container_name: msi-nginx-router
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/ssl:/etc/nginx/ssl:ro
      - ./django-project/static:/app/static
      - ./django-project/media:/app/media
    depends_on:
      - django_app
      - clojure_app
      - jekyll_site
volumes:
  postgres_data:
    driver: local
  lein_cache:
    driver: local

## 2. Konfigurasi Gerbang Penghala Nginx Proxy (nginx.conf)

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;

    upstream django_backend { server django_app:8000; }
    upstream clojure_backend { server clojure_app:7000; }
    upstream jekyll_frontend { server jekyll_site:4000; }

    server {
        listen 80 default_server;
        server_name msi-software.local;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2 default_server;
        server_name msi-software.local;

        ssl_certificate /etc/nginx/ssl/msi_server.crt;
        ssl_certificate_key /etc/nginx/ssl/msi_server.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://jekyll_frontend;
            proxy_set_header Host $host;
        }

        location /api/ {
            proxy_pass http://django_backend;
            proxy_set_header Host $host;
        }

        location /static/ { alias /app/static/; }
        location /media/ { alias /app/media/; }

        location /clojure/ {
            proxy_pass http://clojure_backend/;
            proxy_set_header Host $host;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
        }
    }
}

